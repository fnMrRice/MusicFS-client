@startuml
title MusicFS Client - React + Tauri 实施方案（待实现）
skinparam componentStyle rectangle
top to bottom direction

package "WebView 界面" {
  component "React 主窗口 / 迷你播放器" as UI
  component "React 歌词窗口" as Lyrics
  component "类型化桥接 / 快照 store" as Bridge
  UI --> Bridge
  Lyrics --> Bridge
}

package "Tauri 原生主进程（Rust）" {
  component "命令校验 / 窗口权限" as Commands
  component "PlayerCore\n唯一播放状态与输出时钟" as Core
  component "Server Adapter\nCookie / CSRF / 协商 / SSE" as Adapter
  component "Client Plugin Host\n包校验 / 生命周期 / C ABI" as Host
  component "原生音频引擎\n读取 / 解码 / DSP / 有界 PCM" as Audio
  component "设备输出\n后端待验证" as Output
  component "平台适配\n凭据 / 窗口 / 托盘 / 启动与租约" as Platform
  Commands --> Core : 播放命令
  Commands --> Host : 受限插件管理
  Commands --> Adapter : 类型化业务请求
  Commands --> Platform : 受限系统操作
  Core --> Adapter : 会话 / seek / recover
  Core --> Audio : 播放代次 / 控制
  Host --> Audio : 已校验适配器 / 图租约
  Adapter --> Audio : 原生受权读取接口
  Audio --> Output : PCM
  Output --> Core : 输出帧 / 延迟 / 设备状态
}

component "PluginWorker\n第三方原生插件（开放前验证隔离）" as Worker
component "MusicFS Server\n精确协议由 Server 维护" as Server

Bridge --> Commands : 有界命令 / 查询
Core --> Bridge : 快照 / 状态事件 / 时钟摘要
Host --> Worker : 版本化控制 / 生命周期
Audio <--> Worker : 私有二进制队列或共享缓冲\n不经 WebView 传 PCM
Adapter --> Server : HTTP / 会话 / 播放 / SSE
Platform --> Adapter : 原生定时续租
Platform ..> Server : 仅 managed-local 受控启动

note bottom of Server
  当前 htmlAudio 能力模型需在 Server 扩展并回归后接入原生播放。
  remote / external-local 不自动启动本机 Server。
end note

note bottom of Worker
  Tauri 框架插件与 MusicFS 用户插件分开。
  原生子进程不自动获得权限沙箱。
  原生音频和续租不依赖 React 定时器。
end note
@enduml
