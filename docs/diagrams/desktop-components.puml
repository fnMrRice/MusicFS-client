@startuml
title MusicFS 桌面端组件
skinparam componentStyle rectangle

package "Rust 桌面进程" {
  package "eframe / egui 原生窗口" {
    component "主窗口\n曲库、作品、推荐和歌单" as Main
    component "迷你播放器与歌词窗口" as Mini
  }
  component "桌面状态\n后台任务、当前会话、窗口偏好" as Model
  component "PlayerCore\n队列、播放代次、设备时钟" as Core
  component "Server Adapter\nCookie、CSRF、HTTP、WS" as Adapter
  component "授权流读取 / rodio 解码" as Decode
  component "本机 PCM 处理\n效果、声道与转场" as DSP
  component "默认设备输出" as Output
  component "系统凭据库" as Credentials
  Main --> Model
  Mini --> Model
  Model --> Adapter : 业务查询 / 歌词
  Model --> Core : 播放命令
  Core --> Model : 播放快照
  Core --> Adapter : 创建和关闭播放会话
  Core --> Decode : 当前代次
  Adapter --> Decode : 校验后的音频读取器
  Decode --> DSP : PCM
  DSP --> Output : PCM
  Model --> Credentials : 可选登录保存 / 恢复 / 清除
  Output --> Core : 播放时钟

  package "后续规划" {
    component "插件宿主\n同进程装载 DLL / dylib / so" as Host
    component "解码、DSP、输出与控制插件" as Plugins
    component "受管本地启动器与租约" as Launcher
  }
  Host ..> Plugins : 版本化 C ABI
  Plugins ..> Core : 限定的控制接口
  Launcher ..> Adapter : 受权的本机生命周期操作
}
component "MusicFS Server" as Server
Adapter --> Server : HTTP 登录、查询和音频\nWS 播放控制
Launcher ..> Server : 仅 managed-local 受控启动
note bottom of Host
  用户安装插件、托管启动和租约是后续阶段。
  原生库一经装载会保留至宿主进程退出。
end note
@enduml
